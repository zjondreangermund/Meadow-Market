  "texturingRules": {
    "material": "PBR standard or physical mesh materials: albedo, normal, roughness, optional hair cards and ambient occlusion",
    "uniqueness": "Use markings masks and UV-backed pattern placement varied by the persisted appearanceSeed; never simply paint the entire skinned mesh a flat random colour.",
    "quality": "Mobile-friendly compressed textures and LODs; verify actual live rendering after import.",
    "preserveIdentity": "Reuse person head mesh/skeleton; swap silks and equipment, not face geometry, between farmer and jockey."
